# MediQuery — required environment variables
# Copy this file to .env and fill in your actual values.

# ── LLM ──────────────────────────────────────────────────────────────────────

# API key for Groq (https://console.groq.com/). Used to run the LLM that
# generates answers from retrieved FDA context.
GROQ_API_KEY=your_groq_api_key_here

# Set to "true" to use Groq as the LLM backend. Set to "false" to fall back
# to any locally configured model.
USE_GROQ=true

# ── Vector database ───────────────────────────────────────────────────────────

# API key for Pinecone (https://app.pinecone.io/). Used to query the vector
# store that holds FDA drug label embeddings.
PINECONE_API_KEY=your_pinecone_api_key_here

# ── Observability (Langfuse) ──────────────────────────────────────────────────

# Public and secret keys for your Langfuse project
# (https://cloud.langfuse.com/ or self-hosted). Used for tracing and evaluation.
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here

# Base URL for your Langfuse instance. Use https://cloud.langfuse.com for the
# managed cloud, or your self-hosted URL (e.g. http://localhost:3000).
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── HuggingFace / tokenizers ─────────────────────────────────────────────────

# Disables HuggingFace tokenizer parallelism to prevent deadlocks when the
# server forks worker processes (e.g. on Render or gunicorn). Keep as "false".
TOKENIZERS_PARALLELISM=false
